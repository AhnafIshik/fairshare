NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Needed only by scheduled reminders, optional email, and seed script.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Email delivery for household invitations and optional reminders.
RESEND_API_KEY=
EMAIL_FROM=Fairshare <notifications@your-verified-domain.example>
# Development seed only; never enable against production.
SEED_CONFIRM_DEVELOPMENT=false
SEED_PASSWORD=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional: enable only after configuring the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
